<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/calc_container_margin"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_display"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="@dimen/calc_display_padding"
        android:text="0"
        android:textAppearance="@android:style/TextAppearance.Material.Display1"
        android:textSize="@dimen/calc_display_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:id="@+id/grid_buttons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_display">

        <Button
            android:id="@+id/button_clear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="C"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_divide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="÷"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_multiply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="×"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_subtract"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="−"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_seven"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="7"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_eight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="8"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_nine"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="9"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_add"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="+"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_four"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="4"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_five"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="5"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_six"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="6"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_equals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="="
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_one"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="1"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_two"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="2"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_three"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="3"
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_decimal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="."
            android:textSize="@dimen/calc_button_text_size" />

        <Button
            android:id="@+id/button_zero"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:padding="@dimen/calc_button_padding"
            android:text="0"
            android:textSize="@dimen/calc_button_text_size" />

    </GridLayout>

</android.support.constraint.ConstraintLayout>
